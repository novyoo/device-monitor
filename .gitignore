# .NET build output
backend/**/bin/
backend/**/obj/

# Frontend build copied here only at deploy time, never committed
backend/**/wwwroot/

# Local dev database
backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal

# Secrets — never commit connection strings
backend/**/appsettings.Development.json

# Frontend
frontend/**/node_modules/
frontend/**/dist/

# Local HTTPS dev certificate (exported from dotnet dev-certs, machine-specific)
frontend/**/certs/

# Real per-friend agent configs — hold live ApiKeys, never committed
backend/DeviceOptimizer.Agent/friend-configs/

# This handoff file contains job-application strategy — keep it local only
HANDOFF.md

# Editor/OS noise
.vs/
.vscode/
*.user
Thumbs.db
